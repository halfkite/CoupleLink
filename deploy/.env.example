# Copy to an ignored private .env and generate independent random values.
# Database passwords must be URL-safe (letters, digits, - and _).
POSTGRES_PASSWORD=
COUPLELINK_REALTIME_API_KEY=
COUPLELINK_REALTIME_SECRET=
COUPLELINK_DOMAIN=your-domain.example.com
# Space-separated exact browser origins, optional; native Android has no Origin header.
COUPLELINK_ALLOWED_ORIGINS=
# Keep loopback by default; use an explicit LAN address for phone testing.
COUPLELINK_BIND_IP=127.0.0.1
COUPLELINK_PORT=18080
